POSTGRES_USER=tripfinder
POSTGRES_PASSWORD=tripfinder
POSTGRES_DB=tripfinder
POSTGRES_PORT=5432

# Which LLMProvider implementation the backend uses: `fake` (offline fixtures)
# or `openai`. Defaults to `fake`, so tests and CI can never bill an account
# by accident (plan §9) — set it explicitly to reach a real model.
LLM_PROVIDER=fake

# Required only when LLM_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=

# Which WebSearchProvider the backend uses for discovery: `fake` (offline
# fixtures) or `serper` (real Google results via serper.dev). Defaults to
# `fake` for the same reason as above — set it explicitly to spend a query
# quota (plan §2.11).
SEARCH_PROVIDER=fake

# Required only when SEARCH_PROVIDER=serper. Get one at https://serper.dev
# (2,500 free queries, no card). Never commit a real key.
SERPER_API_KEY=
